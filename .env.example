# 天氣資料來源。目前內建 open-meteo（Open-Meteo 官方格式，無需 API key）。
# 若未設定，預設使用 open-meteo。
VITE_WEATHER_PROVIDER=open-meteo

# 地名搜尋結果使用的語言，ISO 639-1 語言代碼（例如 zh、en、ja）。
# 留空則使用預設值 zh。
VITE_GEOCODING_LANGUAGE=zh

# 備援地名來源（OpenStreetMap Nominatim，免 API key）。
# Open-Meteo 的中文地名索引不完整（例如查「台北」「台中」會查無結果），
# 預設會在查無結果時自動改用 Nominatim；設為 off 可關閉此行為。
VITE_GEOCODING_FALLBACK=on
